APP_NAME=SiteScout
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sitescout
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=localhost:5173
FRONTEND_URL=http://localhost:5173
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Mail (Mailtrap) ───────────────────────────────────────────
# Для разработки используем Mailtrap Sandbox: https://mailtrap.io/inboxes
# Возьмите credentials в Sandbox → Inbox → SMTP Settings → Laravel.
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@sitescout.test"
MAIL_FROM_NAME="SiteScout"
